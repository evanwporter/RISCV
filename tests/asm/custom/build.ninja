as = riscv-none-elf-as
ld = riscv-none-elf-ld
objcopy = riscv-none-elf-objcopy
python  = python

builddir = build

rule assemble
  command = $as $in -o $out
  description = AS $in

rule link
  command = $ld -Ttext=0x0 $in -o $out
  description = LD $out

rule objcopy_bin
  command = $objcopy -O binary $in $out
  description = OBJCOPY $out

rule bin_to_hex
  command = $python ..\..\scripts/bin2hex.py $in $out
  description = BIN2HEX $out

build $builddir/sub.o: assemble sub.s
build $builddir/sub.elf: link $builddir/sub.o
build $builddir/sub.bin: objcopy_bin $builddir/sub.elf
build sub.hex: bin_to_hex $builddir/sub.bin

build $builddir/add.o: assemble add.s
build $builddir/add.elf: link $builddir/add.o
build $builddir/add.bin: objcopy_bin $builddir/add.elf
build add.hex: bin_to_hex $builddir/add.bin

build $builddir/ls.o: assemble ls.s
build $builddir/ls.elf: link $builddir/ls.o
build $builddir/ls.bin: objcopy_bin $builddir/ls.elf
build ls.hex: bin_to_hex $builddir/ls.bin

build $builddir/br.o: assemble br.s
build $builddir/br.elf: link $builddir/br.o
build $builddir/br.bin: objcopy_bin $builddir/br.elf
build br.hex: bin_to_hex $builddir/br.bin 

build $builddir/alu.o: assemble alu.s
build $builddir/alu.elf: link $builddir/alu.o
build $builddir/alu.bin: objcopy_bin $builddir/alu.elf
build alu.hex: bin_to_hex $builddir/alu.bin 

default sub.hex add.hex ls.hex br.hex alu.hex
